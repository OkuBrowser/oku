{
    "files.associations": {
        "*.rs.j2": "rust",
    },
    "rust-analyzer.cargo.features": [
        "serial",
        "parallel",
        "async"
    ],
    "rust-analyzer.files.exclude": [
        "templates"
    ] /*,
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.extraArgs": ["--all-features"]*/
}