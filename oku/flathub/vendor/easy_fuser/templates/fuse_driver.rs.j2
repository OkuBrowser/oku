            ){% if mode == "async" %}.await{% endif %} {
                Ok((result, data)) => { {% call spawn_reply() %} reply.ioctl(result, &data); {% endcall %} }
                Err(e) => {
                    warn!("ioctl: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
