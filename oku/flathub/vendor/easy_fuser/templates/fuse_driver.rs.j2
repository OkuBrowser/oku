    #[cfg(not(feature = "deadlock_detection"))]
    use std::sync::Mutex;

    #[cfg(feature = "deadlock_detection")]
    trait LockMutex<T> {
        fn lock_unwrap(&self) -> parking_lot::MutexGuard<'_, T>;
    }
    #[cfg(feature = "deadlock_detection")]
    impl<T> LockMutex<T> for Mutex<T> {
        fn lock_unwrap(&self) -> parking_lot::MutexGuard<'_, T> {
            self.lock()
        }
    }

    #[cfg(not(feature = "deadlock_detection"))]
    trait LockMutex<T> {
        fn lock_unwrap(&self) -> std::sync::MutexGuard<'_, T>;
    }
    #[cfg(not(feature = "deadlock_detection"))]
    impl<T> LockMutex<T> for Mutex<T> {
        fn lock_unwrap(&self) -> std::sync::MutexGuard<'_, T> {
            self.lock().unwrap()
        }
    }

