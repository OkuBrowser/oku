    fn getattr(&self, req: &Request, ino: INodeNo, fh: Option<FileHandle>, reply: ReplyAttr) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            match handler.getattr(
                &req,
                resolver.resolve_id(ino),
                fh.map(|fh| unsafe { BorrowedFileHandle::from_raw(fh.0) })
            ){% if mode == "async" %}.await{% endif %} {
                {{ reply_attr() }}
                Err(e) => {
                    warn!("getattr: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn getlk(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        lock_owner: LockOwner,
        start: u64,
        end: u64,
        typ: i32,
        pid: u32,
        reply: ReplyLock,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            let lock_info = LockInfo {
                start,
                end,
                lock_type: LockType::from_bits_retain(typ),
                pid,
            };
            match handler.getlk(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_raw(fh.0) },
                lock_owner.0,
                lock_info,
            ){% if mode == "async" %}.await{% endif %} {
                Ok(lock_info) => { {% call spawn_reply() %}
                    reply.locked(
                        lock_info.start,
                        lock_info.end,
                        lock_info.lock_type.bits(),
                        lock_info.pid,
                    )
                {% endcall %} }
                Err(e) => {
                    warn!("getlk: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn getxattr(&self, req: &Request, ino: INodeNo, name: &OsStr, size: u32, reply: ReplyXattr) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        let name = name.to_owned();
        {% call spawn() %}
            match handler.getxattr(
                &req,
                resolver.resolve_id(ino),
                &name, size
            ){% if mode == "async" %}.await{% endif %} {
                Ok(xattr_data) => { {% call spawn_reply() %}
                    if size == 0 {
                        reply.size(xattr_data.len() as u32);
                    } else if size >= xattr_data.len() as u32 {
                        reply.data(&xattr_data);
                    } else {
                        reply.error(ErrorKind::ResultTooLarge.into());
                    }
                {% endcall %} }
                Err(e) => {
                    warn!("getxattr: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

