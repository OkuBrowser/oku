    fn lookup(&self, req: &Request, parent: INodeNo, name: &OsStr, reply: ReplyEntry) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        let name = name.to_owned();
        {% call spawn() %}
            match handler.lookup(
                &req,
                resolver.resolve_id(parent),
                &name
            ){% if mode == "async" %}.await{% endif %} {
                {% call reply_entry("parent", "name") %}{% endcall %}
                Err(e) => {
                    // Failure is expected if user try to lookup a nonexistent file, it should not emit a warning
                    info!("lookup: parent_ino {:x?}, [{}], {:?}", parent, e, req);
                    {{ reply_error() }}
                }
            }
        {% endcall %}
    }

