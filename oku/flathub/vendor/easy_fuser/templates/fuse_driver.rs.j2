impl<TId, THandler> fuser::Filesystem for FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId = TId>,
{
    {% macro spawn() -%}
        {% if mode == "parallel" %}
            let reply_threadpool = self.reply_threadpool.clone();
            self.threadpool.execute(move || {
        {% elif mode == "async" %}
            let runtime = self.runtime.clone();
            self.runtime.spawn(async move {
        {% endif %}
        
        {{ caller() }}
        
        {% if mode == "parallel" || mode == "async" %}
            });
        {% endif %}
    {%- endmacro %}

    {% macro spawn_reply() -%}
        {% if mode == "parallel" %}
            reply_threadpool.execute(move || {
        {% elif mode == "async" %}
            runtime.spawn(async move {
        {% endif %}
        
        {{ caller() }}
        
        {% if mode == "parallel" || mode == "async" %}
            });
        {% endif %}
    {%- endmacro %}

    {% macro reply_error() -%}
        {% call spawn_reply() %}
            reply.error(e.io_error().into());
        {% endcall %}
    {%- endmacro %}

    {% macro reply_entry(parent, name) -%}
        Ok(metadata) => {
            let default_ttl = handler.get_default_ttl();
            let (id, file_attr) = TId::extract_metadata(metadata);
            let ino = resolver.lookup({{ parent }}, &{{ name }}, id, true);
            let (fuse_attr, ttl, generation) = file_attr.to_fuse(ino);
            {% call spawn_reply() %}
                reply.entry(
                    &ttl.unwrap_or(default_ttl),
                    &fuse_attr,
                    fuser::Generation(generation.unwrap_or(get_default_generation())),
                );
            {% endcall %}
        }
    {%- endmacro %}

    {% macro reply_attr() -%}
        Ok(file_attr) => {
            let default_ttl = handler.get_default_ttl();
            let (fuse_attr, ttl, _) = file_attr.to_fuse(ino);
            {% call spawn_reply() %}
                reply.attr(&ttl.unwrap_or(default_ttl), &fuse_attr);
            {% endcall %}
        },
    {%- endmacro %}


    fn init(&mut self, req: &Request, config: &mut KernelConfig) -> Result<(), std::io::Error> {
        let req = RequestInfo::from(req);
        match self.get_handler().init(&req, config) {
            Ok(()) => Ok(()),
            Err(e) => {
                warn!("[{}] init {:?}", e, req);
                Err(e.io_error())
            }
        }
    }

    fn destroy(&mut self) {
        self.get_handler().destroy();
    }

    fn access(&self, req: &Request, ino: INodeNo, mask: AccessFlags, reply: ReplyEmpty) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            match handler.access(
                &req,
                resolver.resolve_id(ino),
                mask,
            ){% if mode == "async" %}.await{% endif %} {
                Ok(()) => { {% call spawn_reply() %}reply.ok();{% endcall %} }
                Err(e) => {
                    warn!("access: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
                
            };
        {% endcall %}
    }

    fn bmap(&self, req: &Request, ino: INodeNo, blocksize: u32, idx: u64, reply: ReplyBmap) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            match handler.bmap(
                &req,
                resolver.resolve_id(ino),
                blocksize,
                idx
            ){% if mode == "async" %}.await{% endif %} {
                Ok(block) => { {% call spawn_reply() %}reply.bmap(block);{% endcall %} }
                Err(e) => {
                    warn!("bmap: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn copy_file_range(
        &self,
        req: &Request,
        ino_in: INodeNo,
        fh_in: FileHandle,
        offset_in: u64,
        ino_out: INodeNo,
        fh_out: FileHandle,
        offset_out: u64,
        len: u64,
        flags: CopyFileRangeFlags,
        reply: ReplyWrite,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            match handler.copy_file_range(
                &req,
                resolver.resolve_id(ino_in),
                unsafe { BorrowedFileHandle::from_raw(fh_in.0) },
                offset_in,
                resolver.resolve_id(ino_out),
                unsafe { BorrowedFileHandle::from_raw(fh_out.0) },
                offset_out,
                len,
                flags,
            ){% if mode == "async" %}.await{% endif %} {
                Ok(bytes_written) => { {% call spawn_reply() %} reply.written(bytes_written);{% endcall %} }
                Err(e) => {
                    warn!("copy_file_range: ino {:x?}, [{}], {:?}", ino_in, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn create(
        &self,
        req: &Request,
        parent: INodeNo,
        name: &OsStr,
        mode: u32,
        umask: u32,
        flags: i32,
        reply: ReplyCreate,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        let name = name.to_owned();
        {% call spawn() %}
            match handler.create(
                &req,
                resolver.resolve_id(parent),
                &name,
                mode,
                umask,
                OpenFlags(flags),
            ){% if mode == "async" %}.await{% endif %} {
                Ok((file_handle, metadata, response_flags)) => {
                    let default_ttl = handler.get_default_ttl();
                    let (id, file_attr) = TId::extract_metadata(metadata);
                    let ino = resolver.lookup(parent, &name, id, true);
                    let (fuse_attr, ttl, generation) = file_attr.to_fuse(ino);
                    {% call spawn_reply() %}
                        reply.created(
                            &ttl.unwrap_or(default_ttl),
                            &fuse_attr,
                            fuser::Generation(generation.unwrap_or(get_default_generation())),
                            fuser::FileHandle(file_handle.as_raw()),
                            response_flags,
                        );
                    {% endcall %}
                }
                Err(e) => {
                    warn!("create: {:?}, parent_ino: {:x?}, {:?}", parent, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn fallocate(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        offset: u64,
        length: u64,
        mode: i32,
        reply: ReplyEmpty,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.resolver.clone();
        {% call spawn() %}
            match handler.fallocate(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_raw(fh.0) },
                offset as i64,
                length as i64,
                FallocateFlags::from_bits_retain(mode),
            ){% if mode == "async" %}.await{% endif %} {
                Ok(()) => { {% call spawn_reply() %} reply.ok(); {% endcall %} }
                Err(e) => {
                    warn!("fallocate: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

